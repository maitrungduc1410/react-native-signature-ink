<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      Library-local FileProvider used by copyToClipboard() to expose the
      rendered signature PNG as a content:// URI. The `${applicationId}`
      placeholder is substituted with the consumer app's package name at
      manifest-merge time, keeping the authority unique per app.

      android:name MUST stay our own subclass, never androidx.core.content.
      FileProvider: the merger keys <provider> by android:name, so the raw
      class collides with every other manifest declaring it. The meta-data
      below is also required — the static getUriForFile() reads the paths
      XML back through PackageManager, not through the subclass.
    -->
    <provider
      android:name="com.signatureink.SignatureInkFileProvider"
      android:authorities="${applicationId}.signatureinkprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/signature_ink_file_paths" />
    </provider>
  </application>
</manifest>
